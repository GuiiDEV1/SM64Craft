--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/GuestShapeClient.java
@@ -0,0 +1,69 @@
+package dev.skycraft.client;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.net.SkyNet;
+import dev.skycraft.world.SkyCollision;
+import java.util.Arrays;
+import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
+import net.minecraft.client.Minecraft;
+
+/**
+ * MarioCraft multiplayer, a guest's level shape for the host's server: the server only has the
+ * host's SM64 level, so near a guest in another level items and mobs fell through the ground.
+ * Every collision message the guest's SM64 sends goes up too (SkyNet.GuestShape), a few per tick,
+ * and all of them again on joining.
+ */
+public final class GuestShapeClient {
+	/** At most this much a tick (about 1 MB a second, only while a level is loading): it goes over the internet. */
+	private static final int BYTES_PER_TICK = 48 * 1024;
+	private static final int PER_TICK = 40;
+	private static boolean wasGuest;
+	private static Object lastConnection;
+	private static int msgId;
+	private static byte[] sending;
+	private static int sendingPart;
+
+	private GuestShapeClient() {
+	}
+
+	/** Every client tick. */
+	public static void tick(Minecraft minecraft) {
+		boolean guest = minecraft.player != null && minecraft.getSingleplayerServer() == null && SkyLink.active()
+			&& ClientPlayNetworking.canSend(SkyNet.GuestShape.TYPE);
+		SkyCollision.uploading = guest;
+		if (guest && (!wasGuest || minecraft.getConnection() != lastConnection)) {
+			SkyCollision.requeueAllForUpload();
+			sending = null;
+		}
+		wasGuest = guest;
+		lastConnection = guest ? minecraft.getConnection() : null;
+		if (!guest) {
+			sending = null;
+			return;
+		}
+		int sent = 0;
+		for (int n = 0; n < PER_TICK && sent < BYTES_PER_TICK; n++) {
+			if (sending == null) {
+				sending = SkyCollision.pollUpload();
+				sendingPart = 0;
+				msgId++;
+				if (sending == null) {
+					return;
+				}
+			}
+			int size = SkyNet.GuestShape.PART_BYTES;
+			int total = (sending.length + size - 1) / size;
+			if (total > 256) {
+				sending = null;  // (bigger than any region SM64 sends)
+				continue;
+			}
+			int from = sendingPart * size;
+			byte[] part = Arrays.copyOfRange(sending, from, Math.min(sending.length, from + size));
+			ClientPlayNetworking.send(new SkyNet.GuestShape(msgId, sendingPart, total, part));
+			sent += part.length;
+			if (++sendingPart == total) {
+				sending = null;
+			}
+		}
+	}
+}
