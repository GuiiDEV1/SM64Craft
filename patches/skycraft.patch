+package dev.skycraft.client;
+
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import net.minecraft.client.Minecraft;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.Blocks;
+
+/** File-driven diagnostics, enabled only in a development client with an explicit path. */
+public final class MultiplayerProbe {
+	private static long next;
+	private static String last = "";
+	private static BlockPos watched;
+	private static boolean enabled, menuAutomation;
+	private static int menuX, menuY;
+	public static boolean menuAutomationActive() { return enabled && menuAutomation; }
+	public static void publishMenuPointer() {
+		var frame = dev.skycraft.link.FrameLink.latest();
+		if (menuAutomationActive() && frame != null) dev.skycraft.link.FrameLink.setMenuPointer(menuX, menuY, frame.width(), frame.height());
+	}
+	private MultiplayerProbe() {}
+	public static void register() {
+		String directory = System.getProperty("mariocraft.probe");
+		if (directory == null || !net.fabricmc.loader.api.FabricLoader.getInstance().isDevelopmentEnvironment()) return;
+		enabled = true;
+		Path root = Path.of(directory);
+		SkyClient.enableMinecraftViewMode();
+		net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents.END_CLIENT_TICK.register(mc -> tick(mc, root));
+	}
+	private static void tick(Minecraft mc, Path root) {
+		if (System.currentTimeMillis() < next) return;
+		next = System.currentTimeMillis() + 500;
+		try {
+			Files.createDirectories(root);
+			Path command = root.resolve("command.json");
+			if (Files.exists(command)) {
+				String raw = Files.readString(command);
+				if (!raw.equals(last)) {
+					last = raw;
+					var request = JsonParser.parseString(raw).getAsJsonObject();
+					switch (request.get("action").getAsString()) {
+						case "join" -> MirrorWorld.joinFriend(mc, request.get("address").getAsString());
+						case "leave" -> MirrorWorld.leaveFriend(mc);
+						case "closeScreen" -> mc.gui.setScreen(null);
+						case "quit" -> mc.stop();
+						case "nativeInput" -> {
+							menuAutomation = true;
+							if (request.has("x")) { menuX = request.get("x").getAsInt(); menuY = request.get("y").getAsInt(); }
+							var frame = dev.skycraft.link.FrameLink.latest();
+							if (request.has("x") && frame != null) dev.skycraft.link.FrameLink.setMenuPointer(request.get("x").getAsInt(), request.get("y").getAsInt(), frame.width(), frame.height());
+							for (var event : request.getAsJsonArray("events")) {
+								var values = event.getAsJsonArray();
+								dev.skycraft.link.FrameLink.pushMenuInput(values.get(0).getAsInt(), values.get(1).getAsInt(), values.get(2).getAsInt(), values.get(3).getAsInt());
+							}
+						}
+						case "watch" -> watched = new BlockPos(request.get("x").getAsInt(), request.get("y").getAsInt(), request.get("z").getAsInt());
+						case "give", "damage" -> {
+							var server = mc.getSingleplayerServer();
+							if (server != null) server.execute(() -> {
+								for (var player : server.getPlayerList().getPlayers()) {
+									if (!player.getPlainTextName().equals(request.get("player").getAsString())) continue;
+									if (request.get("action").getAsString().equals("give")) player.getInventory().add(new net.minecraft.world.item.ItemStack(net.minecraft.world.item.Items.DIAMOND, 7));
+									else player.hurtServer(player.level(), player.damageSources().generic(), 1000);
+								}
+							});
+						}
+						case "block" -> {
+							var server = mc.getSingleplayerServer();
+							if (server != null) server.execute(() -> server.overworld().setBlock(new BlockPos(request.get("x").getAsInt(), request.get("y").getAsInt(), request.get("z").getAsInt()), request.get("present").getAsBoolean() ? Blocks.DIAMOND_BLOCK.defaultBlockState() : Blocks.AIR.defaultBlockState(), 3));
+						}
+					}
+				}
+			}
+			JsonObject state = new JsonObject();
+			state.addProperty("time", System.currentTimeMillis());
+			state.addProperty("linked", dev.skycraft.link.SkyLink.active());
+			state.addProperty("world", mc.level != null);
+			state.addProperty("screen", mc.gui.screen() == null ? "none" : mc.gui.screen().getClass().getSimpleName());
+			state.addProperty("friend", MirrorWorld.friendAddress(mc));
+			state.addProperty("relay", DiscordPresence.currentHostLink());
+			state.addProperty("nativeWorld", SkyClient.sky().worldId);
+			state.addProperty("nativeFlags", SkyClient.sky().flags);
+			state.addProperty("teleportSeq", SkyClient.sky().teleportSeq);
+			state.addProperty("players", mc.getConnection() == null ? 0 : mc.getConnection().getOnlinePlayers().size());
+			if (mc.player != null) {
+				state.addProperty("health", mc.player.getHealth());
+				state.addProperty("clientNoPhysics", mc.player.noPhysics);
+				var nearby = new java.util.ArrayList<dev.skycraft.world.SkyTri>();
+				dev.skycraft.world.SkyCollision.trianglesNear(mc.player.getBoundingBox().inflate(2), nearby);
+				state.addProperty("nearTriangles", nearby.size());
+				state.addProperty("diamonds", mc.player.getInventory().countItem(net.minecraft.world.item.Items.DIAMOND));
+				state.addProperty("x", mc.player.getX()); state.addProperty("y", mc.player.getY()); state.addProperty("z", mc.player.getZ());
+				state.addProperty("diamond", mc.level.getBlockState(BlockPos.containing(mc.player.getX() + 2, mc.player.getY(), mc.player.getZ())).is(Blocks.DIAMOND_BLOCK));
+				if (watched != null) state.addProperty("watchedBlock", mc.level.getBlockState(watched).getBlock().toString());
+			}
+			Files.writeString(root.resolve("state.json"), state.toString());
+			var server = mc.getSingleplayerServer();
+			if (server != null) server.execute(() -> {
+				var players = new com.google.gson.JsonArray();
+				for (var player : server.getPlayerList().getPlayers()) {
+					var entry = new JsonObject();
+					entry.addProperty("name", player.getPlainTextName());
+					entry.addProperty("health", player.getHealth());
+					entry.addProperty("x", player.getX()); entry.addProperty("y", player.getY()); entry.addProperty("z", player.getZ());
+					entry.addProperty("noPhysics", player.noPhysics);
+					players.add(entry);
+				}
+				try { Files.writeString(root.resolve("server.json"), players.toString()); }
+				catch (Exception e) { dev.skycraft.SkyCraft.LOG.error("Probe server snapshot failed", e); }
+			});
+		} catch (Exception e) { dev.skycraft.SkyCraft.LOG.error("Multiplayer probe failed", e); }
+	}
+}
