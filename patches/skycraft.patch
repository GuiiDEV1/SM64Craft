diff --git a/fabric/src/client/resources/assets/skycraft/installer/apply-native-patch.ps1 b/fabric/src/client/resources/assets/skycraft/installer/apply-native-patch.ps1
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/resources/assets/skycraft/installer/apply-native-patch.ps1
@@ -0,0 +1,125 @@
+# Apply a streamed, gzip-compressed bsdiff delta. Both executable hashes are
+# embedded in the delta; this never accepts a different upstream executable.
+function Apply-NativeDelta([string]$Source, [string]$Delta, [string]$Output) {
+    if (-not ('MarioCraftNativeDelta' -as [type])) {
+        Add-Type -TypeDefinition @'
+using System;
+using System.IO;
+using System.IO.Compression;
+using System.Security.Cryptography;
+public static class MarioCraftNativeDelta {
+    static byte[] Read(BinaryReader reader, int count) {
+        byte[] bytes = reader.ReadBytes(count);
+        if (bytes.Length != count) throw new InvalidDataException("Patch truncado.");
+        return bytes;
+    }
+    static bool Same(byte[] a, byte[] b) {
+        if (a.Length != b.Length) return false;
+        for (int i = 0; i < a.Length; i++) if (a[i] != b[i]) return false;
+        return true;
+    }
+    public static void Apply(string sourcePath, string deltaPath, string outputPath) {
+        byte[] source = File.ReadAllBytes(sourcePath);
+        using (var file = File.OpenRead(deltaPath))
+        using (var gzip = new GZipStream(file, CompressionMode.Decompress))
+        using (var reader = new BinaryReader(gzip))
+        using (var hash = SHA256.Create()) {
+            if (System.Text.Encoding.ASCII.GetString(Read(reader, 8)) != "MCDIFF01")
+                throw new InvalidDataException("Formato de patch inválido.");
+            long sourceSize = reader.ReadInt64(), targetSize = reader.ReadInt64();
+            if (sourceSize != source.Length || targetSize <= 0 || targetSize > 268435456)
+                throw new InvalidDataException("Tamanho de executável inválido.");
+            byte[] sourceHash = Read(reader, 32), targetHash = Read(reader, 32);
+            if (!Same(hash.ComputeHash(source), sourceHash))
+                throw new InvalidDataException("O executável oficial não corresponde ao patch.");
+            long count = reader.ReadInt64();
+            if (count < 1 || count > 4000000) throw new InvalidDataException("Patch inválido.");
+            byte[] target = new byte[(int)targetSize];
+            long oldPos = 0, newPos = 0;
+            for (long block = 0; block < count; block++) {
+                long x = reader.ReadInt64(), y = reader.ReadInt64(), z = reader.ReadInt64();
+                if (x < 0 || y < 0 || x > targetSize-newPos || y > targetSize-newPos-x)
+                    throw new InvalidDataException("Patch ultrapassa o executável.");
+                long done = 0;
+                while (done < x) {
+                    int length = (int)Math.Min(65536, x-done);
+                    byte[] part = Read(reader, length);
+                    for (int i = 0; i < length; i++) {
+                        long src = checked(oldPos + done + i);
+                        target[(int)(newPos+done+i)] = unchecked((byte)(part[i] +
+                            ((src >= 0 && src < source.Length) ? source[(int)src] : 0)));
+                    }
+                    done += length;
+                }
+                newPos += x;
+                oldPos = checked(oldPos+x);
+                done = 0;
+                while (done < y) {
+                    int length = (int)Math.Min(65536, y-done);
+                    byte[] part = Read(reader, length);
+                    Buffer.BlockCopy(part, 0, target, (int)(newPos+done), length);
+                    done += length;
+                }
+                newPos += y;
+                oldPos = checked(oldPos+z);
+            }
+            if (newPos != targetSize || gzip.ReadByte() != -1 || !Same(hash.ComputeHash(target), targetHash))
+                throw new InvalidDataException("O resultado do patch não passou na verificação.");
+            File.WriteAllBytes(outputPath, target);
+        }
+    }
+}
+'@
+    }
+    [MarioCraftNativeDelta]::Apply($Source, $Delta, $Output)
+}
+
+function Install-NativePrebuilt([string]$Root, [string]$Work, [string]$Setup) {
+    $manifest = Get-Content -LiteralPath (Join-Path $Setup 'native-manifest.json') -Raw | ConvertFrom-Json
+    if ($manifest.schemaVersion -ne 1 -or $manifest.romIncluded -ne $false -or
+        (Get-Sha (Join-Path $Setup 'sm64coopdx.patch') 'SHA256') -ne $manifest.sourcePatchSha256) {
+        throw 'O pacote nativo não corresponde a esta versão do mod.'
+    }
+    $delta = Join-Path $Setup 'native-delta.gz'
+    if ((Get-Sha $delta 'SHA256') -ne $manifest.deltaSha256) { throw 'O patch nativo está corrompido.' }
+    $archive = Join-Path $Work 'upstream.zip'
+    Set-State 'DOWNLOAD|Baixando o SM64 Coop DX pronto (aprox. 40 MB)...'
+    if (!(Test-Path -LiteralPath $archive) -or (Get-Sha $archive 'SHA256') -ne $manifest.upstreamSha256) {
+        Invoke-WebRequest -Uri $manifest.upstreamUrl -OutFile $archive -UseBasicParsing -TimeoutSec 300
+    }
+    if ((Get-Sha $archive 'SHA256') -ne $manifest.upstreamSha256) { throw 'O download do SM64 Coop DX não passou na verificação.' }
+    Set-State 'EXTRACT|Extraindo o jogo pronto e aplicando as alterações MarioCraft...'
+    $stage = Join-Path $Work 'runtime'
+    if (Test-Path -LiteralPath $stage) { throw 'Já existe uma preparação incompleta; tente novamente.' }
+    New-Item -ItemType Directory -Path $stage | Out-Null
+    $stageFull = [IO.Path]::GetFullPath($stage).TrimEnd('\') + '\'
+	$rootFull = [IO.Path]::GetFullPath($Root).TrimEnd('\') + '\'
+	$gameFull = [IO.Path]::GetFullPath((Join-Path $Root 'game'))
+	if (!$stageFull.StartsWith($rootFull, [StringComparison]::OrdinalIgnoreCase) -or
+		!$gameFull.StartsWith($rootFull, [StringComparison]::OrdinalIgnoreCase)) {
+		throw 'A preparação do jogo precisa ficar dentro da pasta sm64craft.'
+	}
+    Add-Type -AssemblyName System.IO.Compression.FileSystem
+    $zip = [IO.Compression.ZipFile]::OpenRead($archive)
+    try {
+        $total = 0L
+        foreach ($entry in $zip.Entries) {
+            $name = $entry.FullName.Replace('\', '/')
+            if ($name -notmatch '^(dynos/|lang/|mods/|palettes/|sm64coopdx\.exe$|discord_game_sdk\.dll$|coopdx_updater\.exe$)') { continue }
+            $destination = [IO.Path]::GetFullPath((Join-Path $stage $name))
+            if (!$destination.StartsWith($stageFull, [StringComparison]::OrdinalIgnoreCase)) { throw 'Caminho inválido no pacote nativo.' }
+            $total += $entry.Length
+            if ($total -gt 256MB) { throw 'O pacote nativo excedeu o tamanho permitido.' }
+            if (!$entry.Name) { continue }
+            New-Item -ItemType Directory -Force -Path (Split-Path -Parent $destination) | Out-Null
+            [IO.Compression.ZipFileExtensions]::ExtractToFile($entry, $destination, $false)
+        }
+    } finally { $zip.Dispose() }
+    $exe = Join-Path $stage 'sm64coopdx.exe'
+    if ((Get-Sha $exe 'SHA256') -ne $manifest.originalExeSha256) { throw 'O executável oficial não corresponde a esta versão.' }
+    Apply-NativeDelta $exe $delta "$exe.new"
+    if ((Get-Sha "$exe.new" 'SHA256') -ne $manifest.targetExeSha256) { throw 'O executável MarioCraft não passou na verificação.' }
+    Move-Item -LiteralPath "$exe.new" -Destination $exe -Force
+    Copy-Item -LiteralPath (Join-Path $Root 'baserom.us.z64') -Destination (Join-Path $stage 'baserom.us.z64')
+    Move-Item -LiteralPath $stage -Destination $gameFull
+}
diff --git a/fabric/src/client/resources/assets/skycraft/installer/build-native.sh b/fabric/src/client/resources/assets/skycraft/installer/build-native.sh
