index 0000000..f73f6ee
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioCaps.java
@@ -0,0 +1,46 @@
+package dev.skycraft.client;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import net.minecraft.client.Minecraft;
+import net.minecraft.server.level.ServerPlayer;
+
+/**
+ * MarioCraft: Mario's power-ups give Steve Minecraft effects while they last (SM64 runs the cap
+ * timer; SkyState says which cap is on). Refreshed every second for two, so they end with the cap.
+ * The wing cap's flight itself is SkyClient.wingCap.
+ */
+public final class MarioCaps {
+	private static final SkyLink.SkyState SKY = new SkyLink.SkyState();
+	private static int ticks;
+
+	private MarioCaps() {
+	}
+
+	public static void tick(Minecraft minecraft) {
+		if (++ticks % 10 != 0 || minecraft.player == null || !SkyLink.readSkyState(SKY) || !SKY.inGame()) {
+			return;
+		}
+		// An underwater level (Jolly Roger Bay, Dire, Dire Docks...): Steve breathes underwater
+		// while he's in its water, as Mario only runs out of air slowly there.
+		boolean breathe = (SKY.flags & Proto.SKY_WATER_LEVEL) != 0 && (minecraft.player.isInWater() || minecraft.player.isUnderWater());
+		int mask = (SKY.flags & (Proto.SKY_WING_CAP | Proto.SKY_METAL_CAP | Proto.SKY_VANISH_CAP)) | (breathe ? Proto.SKY_WATER_LEVEL : 0);
+		if (mask == 0) {
+			return;
+		}
+		var server = minecraft.getSingleplayerServer();
+		if (server == null) {
+			if (net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking.canSend(dev.skycraft.net.SkyNet.Caps.TYPE)) {
+				net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking.send(new dev.skycraft.net.SkyNet.Caps(mask));
+			}
+			return;
+		}
+		var uuid = minecraft.player.getUUID();
+		server.execute(() -> {
+			ServerPlayer player = server.getPlayerList().getPlayer(uuid);
+			if (player != null) {
+				dev.skycraft.world.MarioFalls.capEffects(player, mask);
+			}
+		});
+	}
+}
