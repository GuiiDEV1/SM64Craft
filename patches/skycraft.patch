+++ b/fabric/src/client/resources/assets/skycraft/installer/build-native.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+export PATH="/mingw64/bin:/usr/bin:$PATH"
+ROOT="/${MARIOCRAFT_MOUNT:?}"
+STATUS="$ROOT/install-status.txt"
+ROM="$ROOT/baserom.us.z64"
+PATCH="$ROOT/.setup/sm64coopdx.patch"
+WORK="$ROOT/.setup/work"
+SOURCE="$WORK/sm64coopdx"
+RUNTIME_NEW="$WORK/runtime"
+RUNTIME="$ROOT/game"
+EXPECTED_COMMIT=8cd6e5977d9f920d51ca71f2c61801d019ed79c6
+USA_SHA1=9bef1128717f958171a4afac3ed78ee2bb4e86ce
+
+set_status() {
+	printf '%s\n' "$1" > "$STATUS"
+}
+
+fail() {
+	set_status "ERROR|$1"
+	echo "PROBLEM: $1" >&2
+	exit 1
+}
+
+if [[ ! -f "$ROM" ]] || [[ "$(sha1sum "$ROM" | cut -d' ' -f1)" != "$USA_SHA1" ]]; then
+	fail 'A ROM USA verificada não foi encontrada em sm64craft.'
+fi
+if [[ -f "$RUNTIME/sm64coopdx.exe" ]]; then
+	set_status 'BUILT|O jogo já foi compilado nesta instância; continuando a instalação.'
+	exit 0
+fi
+if [[ -e "$RUNTIME" ]]; then
+	fail 'A pasta sm64craft/game já existe sem um executável válido. Renomeie-a para preservar os arquivos e tente novamente.'
+fi
+
+set_status 'SOURCE|Baixando as fontes oficiais e aplicando o patch MarioCraft...'
+git clone -q --depth 1 --branch v1.5.1 https://github.com/coop-deluxe/sm64coopdx.git "$SOURCE"
+ACTUAL_COMMIT="$(git -C "$SOURCE" rev-parse HEAD)"
+[[ "$ACTUAL_COMMIT" == "$EXPECTED_COMMIT" ]] || fail "A tag v1.5.1 mudou (commit $ACTUAL_COMMIT); a instalação foi interrompida por segurança."
+git -C "$SOURCE" apply --check --whitespace=nowarn "$PATCH" || fail 'O patch desta versão não corresponde às fontes baixadas.'
+git -C "$SOURCE" apply --whitespace=nowarn "$PATCH" || fail 'Não consegui aplicar o patch MarioCraft.'
+cp "$ROM" "$SOURCE/baserom.us.z64"
+
+set_status "COMPILE|Compilando o SM64 Coop DX com ${MARIOCRAFT_BUILD_JOBS:-2} tarefas..."
+build_ok=0
+initial_jobs="${MARIOCRAFT_BUILD_JOBS:-2}"
+jobs_to_try=("$initial_jobs")
+retry_jobs=$((initial_jobs / 2))
+while [[ "$retry_jobs" -ge 1 ]]; do
+	jobs_to_try+=("$retry_jobs")
+	retry_jobs=$((retry_jobs / 2))
+done
+for jobs in "${jobs_to_try[@]}"; do
+	if (cd "$SOURCE" && make -j"$jobs"); then build_ok=1; break; fi
+	set_status "COMPILE|Ajustando a carga do PC e retomando a compilação com menos tarefas..."
+done
+[[ "$build_ok" == 1 ]] || fail 'A compilação do SM64 Coop DX falhou. Veja sm64craft/install.log.'
+
+BUILT="$SOURCE/build/us_pc"
+[[ -f "$BUILT/sm64coopdx.exe" ]] || fail 'A compilação terminou sem criar sm64coopdx.exe.'
+mkdir -p "$RUNTIME_NEW"
+cp -a "$BUILT/." "$RUNTIME_NEW/"
+# The built game reads its original ROM beside the executable at startup. This is a local,
+# per-instance copy; it is never included in the distributed mod JAR.
+cp "$ROM" "$RUNTIME_NEW/baserom.us.z64"
+# The native build directory contains generated C files, object/dependency files, maps and backups.
+# Keep only the executable, runtime assets and DLLs so the permanent instance install stays small.
+find "$RUNTIME_NEW" -type f \( -name '*.c' -o -name '*.o' -o -name '*.d' -o -name '*.map' \
+	-o -name '*.bak' -o -name '*.dd64' -o -name 'level_rules.mk' \) -delete
+mkdir -p "$(dirname "$RUNTIME")"
+mv "$RUNTIME_NEW" "$RUNTIME"
+[[ -f "$RUNTIME/sm64coopdx.exe" ]] || fail 'Não consegui preparar o executável final.'
+echo "MarioCraft native runtime ready at $RUNTIME"
diff --git a/fabric/src/client/resources/assets/skycraft/installer/install-native.ps1 b/fabric/src/client/resources/assets/skycraft/installer/install-native.ps1
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/resources/assets/skycraft/installer/install-native.ps1
@@ -0,0 +1,168 @@
+param([Parameter(Mandatory = $true)][string]$InstallRoot, [switch]$BuildFromSource)
+
+$ErrorActionPreference = 'Stop'
+$ProgressPreference = 'SilentlyContinue'
+[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
+
+$root = [IO.Path]::GetFullPath($InstallRoot)
+$setup = Join-Path $root '.setup'
+$work = Join-Path $setup 'work'
+$statusFile = Join-Path $root 'install-status.txt'
+$logFile = Join-Path $root 'install.log'
+$sfxName = 'msys2-base-x86_64-20260927.sfx.exe'
+$sfxUrl = 'https://github.com/msys2/msys2-installer/releases/download/2026-09-27/msys2-base-x86_64-20260927.sfx.exe'
+$sfxSha256 = 'ad336cccfda47758b5e15cda993fbba421115cb0b126697daef1ee4dfe37209f'
+$e4mcName = 'e4mc-fabric-6.2.2-modern.jar'
+$e4mcUrl = 'https://cdn.modrinth.com/data/qANg5Jrr/versions/AouleFRY/e4mc-fabric-6.2.2-modern.jar'
+$e4mcSha512 = '01ef0a8c5b76e2cb0effd337bad3350d8807d100d0ec661e01b2ffb20af7b652f756c5eaa11bee233c37905bfd7b573f7a85f3d15bfd2833962c76f02cd59a86'
+$driveLetter = $null
+
+function Set-State([string]$value) {
+	[IO.File]::WriteAllText($statusFile, $value, [Text.UTF8Encoding]::new($false))
+}
+
+function Get-Sha([string]$path, [string]$algorithm) {
+	(Get-FileHash -LiteralPath $path -Algorithm $algorithm).Hash.ToLowerInvariant()
+}
+
+try {
+	if (!(Test-Path -LiteralPath (Join-Path $root 'baserom.us.z64') -PathType Leaf)) {
+		throw 'A ROM verificada não está na pasta sm64craft. Copie sua ROM USA e tente novamente.'
+	}
+	if ((Get-Sha (Join-Path $root 'baserom.us.z64') 'SHA1') -ne '9bef1128717f958171a4afac3ed78ee2bb4e86ce') {
+		throw 'A ROM não corresponde à versão USA suportada.'
+	}
+	$fastManifest = Test-Path -LiteralPath (Join-Path $setup 'native-manifest.json')
+	$fastDelta = Test-Path -LiteralPath (Join-Path $setup 'native-delta.gz')
+	if (!$BuildFromSource -and $fastManifest -ne $fastDelta) { throw 'O pacote rápido está incompleto. Reinstale o JAR.' }
+	$usePrebuilt = !$BuildFromSource -and $fastManifest -and $fastDelta
+	$game = Join-Path $root 'game'
+	if ((Test-Path -LiteralPath $game) -and !(Test-Path -LiteralPath (Join-Path $game 'sm64coopdx.exe'))) {
+		throw 'A pasta game existe sem um executável válido. Preserve-a antes de tentar novamente.'
+	}
+	$rootDrive = [IO.DriveInfo]::new([IO.Path]::GetPathRoot($root))
+	if ($usePrebuilt -and $rootDrive.AvailableFreeSpace -lt 512MB) {
+		throw 'Libere pelo menos 512 MB nesta unidade para preparar o jogo.'
+	}
+	if (!$usePrebuilt -and $rootDrive.AvailableFreeSpace -lt 4GB) {
+		throw 'Libere pelo menos 4 GB nesta unidade para preparar e compilar o SM64 Coop DX. Os arquivos temporários serão removidos depois.'
+	}
+	New-Item -ItemType Directory -Force -Path $work | Out-Null
+
+	$installMethod = 'existing'
+	if (!(Test-Path -LiteralPath (Join-Path $game 'sm64coopdx.exe'))) {
+	if ($usePrebuilt) {
+		. (Join-Path $setup 'apply-native-patch.ps1')
+		Install-NativePrebuilt $root $work $setup
+		$installMethod = 'official-release-binary-delta'
+	} else {
+	$installMethod = 'source-build'
+	$usedLetters = @((Get-PSDrive -PSProvider FileSystem).Name)
+	foreach ($candidate in @('R', 'S', 'T', 'U', 'V', 'W', 'X', 'Y', 'Z')) {
+		if ($usedLetters -notcontains $candidate) { $driveLetter = $candidate; break }
+	}
+	if ($null -eq $driveLetter) { throw 'Não encontrei uma letra livre para montar temporariamente a pasta de compilação.' }
+	$substDrive = "${driveLetter}:"
+	& (Join-Path $env:SystemRoot 'System32\subst.exe') $substDrive $root | Out-Null
+	if ($LASTEXITCODE -ne 0) { throw 'Não consegui preparar o caminho temporário da compilação.' }
+	$mountedRoot = "${driveLetter}:\"
+	$mountedWork = Join-Path $mountedRoot '.setup\work'
+
+	$downloadArchive = Join-Path $work $sfxName
+	$toolchain = Join-Path $mountedWork 'msys2'
+	$bash = Join-Path $toolchain 'usr\bin\bash.exe'
+	if (!(Test-Path -LiteralPath $bash)) { $bash = Join-Path $mountedWork 'usr\bin\bash.exe' }
+	if (!(Test-Path -LiteralPath $bash)) {
+		Set-State 'DOWNLOAD|Baixando o compilador portátil do MSYS2 (aprox. 41 MB)...'
+		$mustDownload = !(Test-Path -LiteralPath $downloadArchive) -or (Get-Sha $downloadArchive 'SHA256') -ne $sfxSha256
+		if ($mustDownload) {
+			Remove-Item -LiteralPath $downloadArchive -Force -ErrorAction SilentlyContinue
+			Invoke-WebRequest -Uri $sfxUrl -OutFile $downloadArchive -UseBasicParsing
+		}
+		if ((Get-Sha $downloadArchive 'SHA256') -ne $sfxSha256) {
+			throw 'O compilador baixado não passou na verificação de integridade.'
+		}
+		Set-State 'EXTRACT|Extraindo as ferramentas dentro da pasta desta instância...'
+		$extract = Start-Process -FilePath (Join-Path $mountedWork $sfxName) -ArgumentList @('-y', ("-o" + $mountedWork)) -WindowStyle Hidden -Wait -PassThru
+		if ($extract.ExitCode -ne 0) { throw 'Não consegui extrair o compilador portátil.' }
+		if (!(Test-Path -LiteralPath $bash)) { $bash = Join-Path $mountedWork 'msys64\usr\bin\bash.exe' }
+		if (!(Test-Path -LiteralPath $bash)) { $bash = Join-Path $mountedWork 'usr\bin\bash.exe' }
+		if (!(Test-Path -LiteralPath $bash)) { throw 'O compilador foi extraído, mas o bash do MSYS2 não apareceu.' }
+	}
+	if (Test-Path -LiteralPath $downloadArchive) {
+		Remove-Item -LiteralPath $downloadArchive -Force
+	}
+
+	$freeRamGb = (Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory / 1MB
+	$logicalCores = [Environment]::ProcessorCount
+	# Use available RAM aggressively while reserving 1 GB for Windows and Minecraft.
+	$memoryJobs = [Math]::Max(1, [int][Math]::Floor(($freeRamGb - 1) / 0.75))
+	$jobs = [Math]::Min($logicalCores, $memoryJobs)
+	$env:MSYSTEM = 'MINGW64'
+	$env:CHERE_INVOKING = '1'
+	$env:MSYS2_PATH_TYPE = 'inherit'
+	$env:MARIOCRAFT_MOUNT = $driveLetter.ToLowerInvariant()
+	$env:MARIOCRAFT_BUILD_JOBS = [string]$jobs
+	Set-State 'TOOLS|Atualizando o compilador portátil e instalando as ferramentas necessárias...'
+	& $bash -l -c 'pacman -Syu --noconfirm'
+	if ($LASTEXITCODE -ne 0) {
+		# A fresh MSYS2 image may need its base packages replaced before the next login shell starts.
+		& $bash -l -c 'pacman -Syu --noconfirm'
+		if ($LASTEXITCODE -ne 0) { throw 'A atualização do MSYS2 falhou. Consulte install.log e tente novamente.' }
+	}
+	Set-State 'BUILD|Baixando as fontes oficiais e compilando o SM64 Coop DX...'
+	$bashCommand = "pacman -S --needed --noconfirm git make python unzip mingw-w64-x86_64-gcc mingw-w64-x86_64-glew mingw-w64-x86_64-SDL2 && (pacman -Scc --noconfirm >/dev/null || true) && bash /$($driveLetter.ToLowerInvariant())/.setup/build-native.sh"
+	& $bash -l -c $bashCommand
+	$buildExitCode = $LASTEXITCODE
+	if ($buildExitCode -ne 0) { throw "A compilação do SM64 Coop DX falhou (código $buildExitCode). Consulte install.log." }
+	}
+	}
+
+	Set-State 'NETWORK|Baixando o suporte de multiplayer e verificando o arquivo...'
+	$gameDirectory = Split-Path -Parent $root
+	$mods = Join-Path $gameDirectory 'mods'
+	New-Item -ItemType Directory -Force -Path $mods | Out-Null
+	$e4mc = Join-Path $mods $e4mcName
+	if (Test-Path -LiteralPath $e4mc) {
+		if ((Get-Sha $e4mc 'SHA512') -ne $e4mcSha512) {
+			throw "Já existe $e4mcName em mods, mas o conteúdo não corresponde à versão necessária. O arquivo foi preservado."
+		}
+	} else {
+		$partial = "$e4mc.partial"
+		Invoke-WebRequest -Uri $e4mcUrl -OutFile $partial -UseBasicParsing
+		if ((Get-Sha $partial 'SHA512') -ne $e4mcSha512) {
+			Remove-Item -LiteralPath $partial -Force -ErrorAction SilentlyContinue
+			throw 'O suporte de multiplayer baixado não passou na verificação de integridade.'
+		}
+		Move-Item -LiteralPath $partial -Destination $e4mc
+	}
+	[IO.File]::WriteAllText((Join-Path $root 'restart-required'), 'Restart Minecraft once to load e4mc.', [Text.UTF8Encoding]::new($false))
+
+	Set-State 'CLEANUP|Limpando fontes, cache e compilador temporário para economizar espaço...'
+	$workFull = [IO.Path]::GetFullPath($work).TrimEnd('\')
+	$allowedWork = [IO.Path]::GetFullPath((Join-Path $setup 'work')).TrimEnd('\')
+	if ($workFull -ieq $allowedWork) { Remove-Item -LiteralPath $workFull -Recurse -Force }
+	$metadata = @{
+		schemaVersion = 1
+		sm64coopdx = 'v1.5.1'
+		sourceCommit = '8cd6e5977d9f920d51ca71f2c61801d019ed79c6'
+		romSha1 = '9bef1128717f958171a4afac3ed78ee2bb4e86ce'
+		installMethod = $installMethod
+	} | ConvertTo-Json
+	[IO.File]::WriteAllText((Join-Path $root 'installed.json'), $metadata, [Text.UTF8Encoding]::new($false))
+	Set-State 'DONE|Tudo instalado. Reinicie o Minecraft para carregar o multiplayer.'
+} catch {
+	$message = $_.Exception.Message.Replace("`r", ' ').Replace("`n", ' ')
+	Set-State "ERROR|$message"
+	Write-Error $_
+} finally {
+	$workFull = [IO.Path]::GetFullPath($work).TrimEnd('\')
+	$allowedWork = [IO.Path]::GetFullPath((Join-Path $setup 'work')).TrimEnd('\')
+	if ($workFull -ieq $allowedWork -and (Test-Path -LiteralPath $workFull)) {
+		Remove-Item -LiteralPath $workFull -Recurse -Force -ErrorAction SilentlyContinue
+	}
+	if ($null -ne $driveLetter) {
+		$substDrive = "${driveLetter}:"
+		& (Join-Path $env:SystemRoot 'System32\subst.exe') $substDrive /d | Out-Null
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/link/ViewResolution.java b/fabric/src/main/java/dev/skycraft/link/ViewResolution.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/link/ViewResolution.java
@@ -0,0 +1,11 @@
+package dev.skycraft.link;
+
+/** A small render surface with the same aspect ratio as the visible window. */
+public record ViewResolution(int width, int height) {
+    public static ViewResolution fit(int width, int height) {
+        if (width <= 0 || height <= 0) return new ViewResolution(960, 540);
+        double scale = Math.min(1.0, Math.min(960.0 / width, 540.0 / height));
+        return new ViewResolution(Math.max(1, (int) Math.round(width * scale)),
+            Math.max(1, (int) Math.round(height * scale)));
+    }
+}
diff --git a/fabric/src/main/java/dev/skycraft/net/GeometryReadiness.java b/fabric/src/main/java/dev/skycraft/net/GeometryReadiness.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/net/GeometryReadiness.java
@@ -0,0 +1,10 @@
+package dev.skycraft.net;
+
+/** A cached floor from an earlier load cannot release a pending teleport. */
+public final class GeometryReadiness {
+	private GeometryReadiness() {}
+	public static boolean ready(int expectedEpoch, int receivedEpoch, boolean known,
+		boolean exactGround, boolean airborneRelease, boolean timedOut) {
+		return expectedEpoch == receivedEpoch && known && (exactGround || airborneRelease || timedOut);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/net/RegionAuthority.java b/fabric/src/main/java/dev/skycraft/net/RegionAuthority.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/net/RegionAuthority.java
@@ -0,0 +1,15 @@
+package dev.skycraft.net;
+
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Guests fill other areas; they cannot replace this client's own current geometry. */
+public final class RegionAuthority {
+	private final Set<Long> local = ConcurrentHashMap.newKeySet();
+	public boolean accept(long region, boolean guest) {
+		if (guest) return !local.contains(region);
+		local.add(region);
+		return true;
+	}
+	public void clear() { local.clear(); }
+}
diff --git a/fabric/src/test/java/dev/skycraft/net/GeometryReadinessTest.java b/fabric/src/test/java/dev/skycraft/net/GeometryReadinessTest.java
