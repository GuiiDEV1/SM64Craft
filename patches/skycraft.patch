+package dev.skycraft.client.render;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import net.minecraft.client.Minecraft;
+import net.minecraft.resources.Identifier;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * MarioCraft: the player's face from their skin (the 8x8 face and the hat layer over it), for SM64's
+ * HUD head (mc_steve.c): you see your own Steve next to the lives counter.
+ */
+public final class SkinFace {
+	private static @Nullable Identifier lastSkin;
+	private static int @Nullable [] lastFace;
+
+	private SkinFace() {
+	}
+
+	/** 64 pixels, RGBA (r in the low byte), or null if the skin can't be read yet. */
+	public static int @Nullable [] face(Minecraft minecraft) {
+		if (minecraft.player == null) {
+			return null;
+		}
+		Identifier skin = minecraft.player.getSkin().body().texturePath();
+		if (skin.equals(lastSkin) && lastFace != null) {
+			return lastFace;
+		}
+		NativeImage image = AvatarExporter.readTexture(skin);
+		if (image == null) {
+			return null; // (a downloaded skin may not be there yet)
+		}
+		try {
+			int[] face = new int[64];
+			for (int y = 0; y < 8; y++) {
+				for (int x = 0; x < 8; x++) {
+					int base = image.getPixel(8 + x, 8 + y);   // ABGR
+					int hat = image.getWidth() >= 48 ? image.getPixel(40 + x, 8 + y) : 0;
+					int c = ((hat >>> 24) & 0xFF) >= 128 ? hat : base;
+					face[y * 8 + x] = c | 0xFF000000; // ABGR is RGBA with r in the low byte
+				}
+			}
+			lastSkin = skin;
+			lastFace = face;
+			return face;
+		} finally {
+			image.close();
+		}
+	}
+}
