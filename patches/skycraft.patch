+++ b/fabric/src/test/java/dev/skycraft/net/GeometryReadinessTest.java
@@ -0,0 +1,20 @@
+package dev.skycraft.net;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class GeometryReadinessTest {
+	@Test void oldGuestFloorCannotReleaseANewLevelTeleport() {
+		assertFalse(GeometryReadiness.ready(6, 5, true, true, false, false));
+		assertFalse(GeometryReadiness.ready(6, 5, true, true, true, true));
+	}
+	@Test void voxelArrivalMustWaitForTheExactCollisionMesh() {
+		assertFalse(GeometryReadiness.ready(6, 6, true, false, false, false));
+		assertTrue(GeometryReadiness.ready(6, 6, true, true, false, false));
+	}
+	@Test void intentionalAirborneReleaseAndTimeoutStillWork() {
+		assertTrue(GeometryReadiness.ready(6, 6, true, false, true, false));
+		assertTrue(GeometryReadiness.ready(6, 6, true, false, false, true));
+		assertFalse(GeometryReadiness.ready(6, 6, false, true, true, true));
+	}
+}
diff --git a/fabric/src/test/java/dev/skycraft/net/RegionAuthorityTest.java b/fabric/src/test/java/dev/skycraft/net/RegionAuthorityTest.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/test/java/dev/skycraft/net/RegionAuthorityTest.java
@@ -0,0 +1,28 @@
+package dev.skycraft.net;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class RegionAuthorityTest {
+	@Test void delayedGuestRegionCannotEraseTheHostsFloor() {
+		var authority = new RegionAuthority();
+		assertTrue(authority.accept(257, true));
+		assertTrue(authority.accept(257, false));
+		assertFalse(authority.accept(257, true));
+		assertTrue(authority.accept(257, false));
+	}
+	@Test void guestsCanPopulateASeparateArea() {
+		var authority = new RegionAuthority();
+		authority.accept(257, false);
+		assertTrue(authority.accept(145, true));
+		assertFalse(authority.accept(257, true));
+	}
+	@Test void changingLevelLetsGuestGeometryReturnInThePreviousArea() {
+		var authority = new RegionAuthority();
+		authority.accept(257, false);
+		authority.clear();
+		assertTrue(authority.accept(257, true));
+		assertTrue(authority.accept(145, false));
+		assertFalse(authority.accept(145, true));
+	}
+}
