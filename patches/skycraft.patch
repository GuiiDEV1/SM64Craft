@@ -0,0 +1,142 @@
+package dev.skycraft.client;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import net.fabricmc.loader.api.FabricLoader;
+
+/** Downloads and prepares MarioCraft's patched native game inside this Minecraft instance. */
+public final class MarioCraftDependencyInstaller {
+	private static final String SCRIPT = "/assets/skycraft/installer/install-native.ps1";
+	private static final String BUILD_SCRIPT = "/assets/skycraft/installer/build-native.sh";
+	private static final String PATCH = "/assets/skycraft/installer/sm64coopdx.patch";
+	private static final String FAST_PATCH = "/assets/skycraft/installer/apply-native-patch.ps1";
+	private static final String FAST_MANIFEST = "/assets/skycraft/installer/native-manifest.json";
+	private static final String FAST_DELTA = "/assets/skycraft/installer/native-delta.gz";
+	private static volatile MarioCraftDependencyInstaller active;
+
+	private final Path installRoot;
+	private final Path statusFile;
+	private final Path logFile;
+	private volatile Process process;
+	private volatile int exitCode = Integer.MIN_VALUE;
+
+	private MarioCraftDependencyInstaller(Path installRoot) {
+		this.installRoot = installRoot;
+		this.statusFile = installRoot.resolve("install-status.txt");
+		this.logFile = installRoot.resolve("install.log");
+	}
+
+	public static Path installRoot(Path gameDirectory) {
+		return MarioCraftRom.folder(gameDirectory);
+	}
+
+	public static boolean isInstalled(Path gameDirectory) {
+		Path root = installRoot(gameDirectory);
+		// This method is used from the title-screen mixin and setup screen every frame. Keep it
+		// metadata-only; validating the 8 MiB ROM hash is done once when the user starts setup.
+		return Files.isRegularFile(root.resolve("installed.json"))
+			&& Files.isRegularFile(root.resolve("game/sm64coopdx.exe"))
+			&& Files.isRegularFile(root.resolve("baserom.us.z64"));
+	}
+
+	public static boolean multiplayerRestartRequired(Path gameDirectory) {
+		return Files.isRegularFile(installRoot(gameDirectory).resolve("restart-required"));
+	}
+
+	/** Clear the one-time restart prompt only after Fabric confirms the helper mod loaded. */
+	public static void clearRestartFlagIfMultiplayerLoaded(Path gameDirectory) {
+		if (!FabricLoader.getInstance().isModLoaded("e4mc")) return;
+		try {
+			Files.deleteIfExists(installRoot(gameDirectory).resolve("restart-required"));
+		} catch (IOException e) {
+			dev.skycraft.SkyCraft.LOG.warn("MarioCraft: couldn't clear the e4mc restart marker", e);
+		}
+	}
+
+	public static synchronized MarioCraftDependencyInstaller current(Path gameDirectory) {
+		Path root = installRoot(gameDirectory);
+		if (active == null || !active.installRoot.equals(root)) active = new MarioCraftDependencyInstaller(root);
+		return active;
+	}
+
+	public synchronized void start() throws IOException {
+		if (running()) return;
+		if (!System.getProperty("os.name", "").toLowerCase(java.util.Locale.ROOT).contains("windows")) {
+			throw new IOException("O assistente de instalação do SM64 Coop DX está disponível para Windows nesta versão.");
+		}
+		Files.createDirectories(installRoot);
+		Path setup = installRoot.resolve(".setup");
+		Files.createDirectories(setup);
+		copyResource(SCRIPT, setup.resolve("install-native.ps1"));
+		copyResource(BUILD_SCRIPT, setup.resolve("build-native.sh"));
+		copyResource(PATCH, setup.resolve("sm64coopdx.patch"));
+		copyResource(FAST_PATCH, setup.resolve("apply-native-patch.ps1"));
+		copyOptionalResource(FAST_MANIFEST, setup.resolve("native-manifest.json"));
+		copyOptionalResource(FAST_DELTA, setup.resolve("native-delta.gz"));
+		Files.deleteIfExists(statusFile);
+		exitCode = Integer.MIN_VALUE;
+		ProcessBuilder builder = new ProcessBuilder(
+			"powershell.exe", "-NoLogo", "-NoProfile", "-WindowStyle", "Hidden",
+			"-ExecutionPolicy", "Bypass", "-File", setup.resolve("install-native.ps1").toString(),
+			"-InstallRoot", installRoot.toString()
+		);
+		builder.redirectErrorStream(true);
+		builder.redirectOutput(logFile.toFile());
+		process = builder.start();
+		Process watching = process;
+		Thread monitor = new Thread(() -> {
+			try {
+				exitCode = watching.waitFor();
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+				exitCode = 1;
+			}
+		}, "mariocraft-dependency-installer");
+		monitor.setDaemon(true);
+		monitor.start();
+	}
+
+	public boolean running() {
+		Process current = process;
+		return current != null && current.isAlive();
+	}
+
+	public int exitCode() {
+		return exitCode;
+	}
+
+	public String status() {
+		try {
+			if (Files.isRegularFile(statusFile)) {
+				return Files.readString(statusFile, StandardCharsets.UTF_8).trim();
+			}
+		} catch (IOException ignored) { }
+		if (running()) return "PREPARING|Iniciando a preparação...";
+		if (exitCode == 0) return "DONE|Dependências instaladas.";
+		if (exitCode != Integer.MIN_VALUE) return "ERROR|A instalação não terminou. Abra install.log para ver o erro.";
+		return "IDLE|Aguardando instalação.";
+	}
+
+	public Path logFile() {
+		return logFile;
+	}
+
+	private static void copyOptionalResource(String resource, Path target) throws IOException {
+		try (InputStream in = MarioCraftDependencyInstaller.class.getResourceAsStream(resource)) {
+			if (in == null) Files.deleteIfExists(target);
+			else Files.copy(in, target, StandardCopyOption.REPLACE_EXISTING);
+		}
+	}
+
+	private static void copyResource(String resource, Path target) throws IOException {
+		try (InputStream in = MarioCraftDependencyInstaller.class.getResourceAsStream(resource)) {
+			if (in == null) throw new IOException("Recurso de instalação ausente no JAR: " + resource);
+			Files.copy(in, target, StandardCopyOption.REPLACE_EXISTING);
+		}
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MarioCraftNativeGame.java b/fabric/src/client/java/dev/skycraft/client/MarioCraftNativeGame.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioCraftNativeGame.java
@@ -0,0 +1,92 @@
+package dev.skycraft.client;
+
+import net.minecraft.client.Minecraft;
+import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientLifecycleEvents;
+import net.minecraft.network.chat.Component;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.TimeUnit;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import dev.skycraft.link.ViewResolution;
+import dev.skycraft.link.FrameLink;
+
+/** Starts the ROM-built SM64 process from the active instance's private sm64craft folder. */
+public final class MarioCraftNativeGame {
+	private static volatile Process process;
+
+	private MarioCraftNativeGame() { }
+
+	public static void register() {
+		ClientLifecycleEvents.CLIENT_STOPPING.register(client -> closeWithWindowMessage());
+	}
+
+	public static boolean running() {
+		Process current = process;
+		return current != null && current.isAlive();
+	}
+
+	public static void launch(Minecraft minecraft) throws IOException {
+		Path root = MarioCraftDependencyInstaller.installRoot(minecraft.gameDirectory.toPath());
+		Path executable = root.resolve("game/sm64coopdx.exe");
+		if (!MarioCraftDependencyInstaller.isInstalled(minecraft.gameDirectory.toPath()) || !Files.isRegularFile(executable)) {
+			throw new IOException("Instale as dependências e valide sua ROM USA antes de iniciar.");
+		}
+		if (!MarioCraftRom.hasUsaHash(root.resolve("baserom.us.z64"))) {
+			throw new IOException("A ROM baserom.us.z64 foi alterada ou não é a ROM USA validada.");
+		}
+		if (running()) throw new IOException("O SM64 Coop DX já está aberto nesta instância.");
+		Path saves = root.resolve("saves");
+		Files.createDirectories(saves);
+		ViewResolution size = ViewResolution.fit(minecraft.getWindow().getWidth(), minecraft.getWindow().getHeight());
+		Path config = saves.resolve("sm64config.txt");
+		var settings = new ArrayList<String>();
+		if (Files.isRegularFile(config)) {
+			for (String line : Files.readAllLines(config, StandardCharsets.UTF_8)) {
+				if (!line.matches("^\\s*(window_w|window_h|fullscreen)\\s+.*")) settings.add(line);
+			}
+		}
+		settings.add("fullscreen false");
+		settings.add("window_w " + size.width());
+		settings.add("window_h " + size.height());
+		Files.write(config, settings, StandardCharsets.UTF_8);
+		ProcessBuilder builder = new ProcessBuilder(executable.toString(), "--console", "--savepath", saves.toString(), "--backend", "directx")
+			.directory(root.resolve("game").toFile())
+			.redirectErrorStream(true)
+			.redirectOutput(root.resolve("native.log").toFile());
+		builder.environment().put("MARIOCRAFT_EMBEDDED_VIEW", "1");
+		builder.environment().put("MARIOCRAFT_LINK", dev.skycraft.link.Proto.MAPPING_NAME);
+		builder.environment().put("MARIOCRAFT_FRAME_LINK", System.getProperty("skycraft.frameLink",
+			dev.skycraft.link.Proto.MAPPING_NAME.equals("Local\\MarioCraft_v1") ? "Local\\MarioCraftFrame_v2" : dev.skycraft.link.Proto.MAPPING_NAME + "_frame"));
+		process = builder.start();
+		Process started = process;
+		SkyClient.enableMinecraftViewMode();
+		started.onExit().thenAccept(closed -> {
+			if (closed.exitValue() != 0) {
+				dev.skycraft.SkyCraft.LOG.warn("MarioCraft: sm64coopdx exited with code {}", closed.exitValue());
+			}
+		});
+	}
+
+	public static void closeWithWindowMessage() {
+		Process current = process;
+		if (current == null || !current.isAlive()) return;
+		try {
+			// Hidden windows are not returned by Process.MainWindowHandle. Ask the
+			// native render thread to close normally and flush its saves first.
+			FrameLink.requestClose();
+			if (current.waitFor(2, TimeUnit.SECONDS)) return;
+			String command = "$p=Get-Process -Id " + current.pid()
+				+ " -ErrorAction SilentlyContinue; if($p){$null=$p.CloseMainWindow(); if(!$p.WaitForExit(3000)){$p.Kill()}}";
+			Process closeRequest = new ProcessBuilder("powershell.exe", "-NoLogo", "-NoProfile", "-WindowStyle", "Hidden", "-Command", command)
+				.redirectErrorStream(true).start();
+			if (!closeRequest.waitFor(4, TimeUnit.SECONDS)) closeRequest.destroyForcibly();
+		} catch (IOException e) {
+			dev.skycraft.SkyCraft.LOG.warn("MarioCraft: couldn't send a graceful close to SM64", e);
+		} catch (InterruptedException e) {
+			Thread.currentThread().interrupt();
+		}
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MarioCraftRom.java b/fabric/src/client/java/dev/skycraft/client/MarioCraftRom.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioCraftRom.java
@@ -0,0 +1,138 @@
+package dev.skycraft.client;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.StandardCopyOption;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+
+/** Finds and locally normalizes a player's own USA ROM without changing the original dump. */
+public final class MarioCraftRom {
+	public static final String USA_SHA1 = "9bef1128717f958171a4afac3ed78ee2bb4e86ce";
+	private static final int ROM_SIZE = 8 * 1024 * 1024;
+
+	private MarioCraftRom() { }
+
+	public static Path folder(Path gameDirectory) {
+		return gameDirectory.resolve("sm64craft").toAbsolutePath().normalize();
+	}
+
+	/** Cheap UI check; does not read or hash the ROM. */
+	public static boolean hasCandidate(Path gameDirectory) {
+		Path folder = folder(gameDirectory);
+		if (Files.isRegularFile(folder.resolve("baserom.us.z64"))) return true;
+		if (!Files.isDirectory(folder)) return false;
+		try (var files = Files.list(folder)) {
+			return files.anyMatch(path -> {
+				if (!Files.isRegularFile(path)) return false;
+				String name = path.getFileName().toString().toLowerCase(Locale.ROOT);
+				return name.endsWith(".z64") || name.endsWith(".n64") || name.endsWith(".v64");
+			});
+		} catch (IOException e) {
+			return false;
+		}
+	}
+
+	/** Returns the verified, big-endian build input, or null if no supported USA dump is present. */
+	public static Path prepare(Path gameDirectory) throws IOException {
+		Path folder = folder(gameDirectory);
+		Files.createDirectories(folder);
+		Path canonical = folder.resolve("baserom.us.z64");
+		if (Files.isRegularFile(canonical) && hasUsaHash(canonical)) {
+			return canonical;
+		}
+		if (Files.exists(canonical)) {
+			throw new IOException("baserom.us.z64 já existe, mas não é a ROM USA esperada. Renomeie esse arquivo e tente de novo.");
+		}
+
+		List<Path> candidates;
+		try (var files = Files.list(folder)) {
+			candidates = files.filter(Files::isRegularFile)
+				.filter(path -> {
+					String name = path.getFileName().toString().toLowerCase(Locale.ROOT);
+					return name.endsWith(".z64") || name.endsWith(".n64") || name.endsWith(".v64");
+				})
+				.sorted(Comparator.comparing(path -> path.getFileName().toString().toLowerCase(Locale.ROOT)))
+				.toList();
+		}
+		if (candidates.isEmpty()) return null;
+
+		IOException lastError = null;
+		for (Path candidate : candidates) {
+			try {
+				if (Files.size(candidate) != ROM_SIZE) {
+					lastError = new IOException(candidate.getFileName() + " não tem o tamanho esperado de uma ROM USA de 8 MiB.");
+					continue;
+				}
+				byte[] bytes = Files.readAllBytes(candidate);
+				if (!normalize(bytes)) {
+					lastError = new IOException(candidate.getFileName() + " não está em um formato N64 reconhecido.");
+					continue;
+				}
+				if (!USA_SHA1.equals(sha1(bytes))) {
+					lastError = new IOException(candidate.getFileName() + " não corresponde à ROM Super Mario 64 USA.");
+					continue;
+				}
+				Path temporary = folder.resolve("baserom.us.z64.partial");
+				try {
+					Files.write(temporary, bytes);
+					try {
+						Files.move(temporary, canonical, StandardCopyOption.ATOMIC_MOVE);
+					} catch (AtomicMoveNotSupportedException ignored) {
+						Files.move(temporary, canonical);
+					}
+				} finally {
+					Files.deleteIfExists(temporary);
+				}
+				return canonical;
+			} catch (IOException e) {
+				lastError = e;
+			}
+		}
+		if (lastError != null) throw lastError;
+		return null;
+	}
+
+	public static boolean hasUsaHash(Path rom) {
+		try {
+			return USA_SHA1.equals(sha1(Files.readAllBytes(rom)));
+		} catch (IOException e) {
+			return false;
+		}
+	}
+
+	private static boolean normalize(byte[] bytes) {
+		int a = bytes[0] & 0xff, b = bytes[1] & 0xff, c = bytes[2] & 0xff, d = bytes[3] & 0xff;
+		if (a == 0x80 && b == 0x37 && c == 0x12 && d == 0x40) return true;
+		if (a == 0x40 && b == 0x12 && c == 0x37 && d == 0x80) {
+			for (int i = 0; i < bytes.length; i += 4) {
+				byte x = bytes[i]; bytes[i] = bytes[i + 3]; bytes[i + 3] = x;
+				x = bytes[i + 1]; bytes[i + 1] = bytes[i + 2]; bytes[i + 2] = x;
+			}
+			return true;
+		}
+		if (a == 0x37 && b == 0x80 && c == 0x40 && d == 0x12) {
+			for (int i = 0; i < bytes.length; i += 2) {
+				byte x = bytes[i]; bytes[i] = bytes[i + 1]; bytes[i + 1] = x;
+			}
+			return true;
+		}
+		return false;
+	}
+
+	private static String sha1(byte[] bytes) {
+		try {
+			byte[] digest = MessageDigest.getInstance("SHA-1").digest(bytes);
+			StringBuilder result = new StringBuilder(digest.length * 2);
+			for (byte value : digest) result.append(String.format(Locale.ROOT, "%02x", value & 0xff));
+			return result.toString();
+		} catch (NoSuchAlgorithmException e) {
+			throw new IllegalStateException("SHA-1 is unavailable", e);
+		}
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MarioCraftSetupScreen.java b/fabric/src/client/java/dev/skycraft/client/MarioCraftSetupScreen.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioCraftSetupScreen.java
@@ -0,0 +1,154 @@
+package dev.skycraft.client;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.gui.components.Button;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.client.gui.screens.TitleScreen;
+import net.minecraft.network.chat.Component;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/** First-run wizard for the native SM64 files stored in this Minecraft instance. */
+public final class MarioCraftSetupScreen extends Screen {
+	private final Screen parent;
+	private Button installButton;
+	private Button restartButton;
+	private String message = "Coloque sua ROM USA na pasta indicada e instale os componentes.";
+	private int refreshTicks;
+
+	public MarioCraftSetupScreen(Screen parent) {
+		super(Component.literal("MarioCraft Setup"));
+		this.parent = parent;
+	}
+
+	@Override
+	protected void init() {
+		int center = width / 2;
+		int y = height / 2 - 8;
+		installButton = addRenderableWidget(Button.builder(Component.literal("Instalar dependências"), button -> installOrLaunch())
+			.bounds(center - 110, y, 220, 20).build());
+		addRenderableWidget(Button.builder(Component.literal("Abrir pasta sm64craft"), button -> openInstallFolder())
+			.bounds(center - 110, y + 26, 220, 20).build());
+		addRenderableWidget(Button.builder(Component.literal("Voltar"), button -> onClose())
+			.bounds(center - 110, y + 52, 220, 20).build());
+		restartButton = addRenderableWidget(Button.builder(Component.literal("Reiniciar Minecraft"), button -> Minecraft.getInstance().stop())
+			.bounds(center - 110, y + 78, 220, 20).build());
+		restartButton.visible = false;
+		restartButton.active = false;
+		refreshState();
+	}
+
+	@Override
+	public void tick() {
+		if (++refreshTicks >= 10) {
+			refreshTicks = 0;
+			refreshState();
+		}
+	}
+
+	@Override
+	public void extractRenderState(GuiGraphicsExtractor gui, int mouseX, int mouseY, float partialTick) {
+		super.extractRenderState(gui, mouseX, mouseY, partialTick);
+		gui.centeredText(font, "MarioCraft: preparação desta instância", width / 2, height / 2 - 90, 0xFFFFFFFF);
+		gui.centeredText(font, "A ROM fica no seu computador e não é enviada nem incluída no mod.", width / 2, height / 2 - 70, 0xFFDDDDDD);
+		gui.centeredText(font, fit("Pasta: " + MarioCraftRom.folder(minecraft.gameDirectory.toPath()), width - 32), width / 2, height / 2 - 48, 0xFFBBBBBB);
+		gui.centeredText(font, fit(message, width - 32), width / 2, height / 2 - 29, 0xFFFFFFFF);
+		if (restartButton != null && restartButton.visible)
+			gui.centeredText(font, "Reinicie uma vez para ativar o multiplayer (e4mc).", width / 2, height / 2 + 108, 0xFFBBBBBB);
+	}
+
+	@Override
+	public boolean isPauseScreen() {
+		return false;
+	}
+
+	@Override
+	public void onClose() {
+		minecraft.gui.setScreen(parent != null ? parent : new TitleScreen());
+	}
+
+	private void refreshState() {
+		if (installButton == null) return;
+		Path gameDirectory = minecraft.gameDirectory.toPath();
+		MarioCraftDependencyInstaller installer = MarioCraftDependencyInstaller.current(gameDirectory);
+		if (installer.running()) {
+			message = installer.status().replaceFirst("^[^|]*\\|", "");
+			installButton.setMessage(Component.literal("Instalando..."));
+			installButton.active = false;
+			restartButton.visible = false;
+			restartButton.active = false;
+			return;
+		}
+		if (installer.exitCode() != Integer.MIN_VALUE && installer.exitCode() != 0) {
+			String lastStatus = installer.status();
+			message = lastStatus.startsWith("ERROR|") ? lastStatus.substring("ERROR|".length()) : "Falhou. Consulte sm64craft/install.log e tente novamente.";
+		}
+		boolean ready = MarioCraftDependencyInstaller.isInstalled(gameDirectory);
+		boolean restartRequired = installer.exitCode() == 0
+			|| MarioCraftDependencyInstaller.multiplayerRestartRequired(gameDirectory);
+		installButton.active = !restartRequired;
+		installButton.setMessage(Component.literal(restartRequired ? "Reinicie para continuar"
+			: ready ? "Iniciar MarioCraft" : "Instalar dependências"));
+		restartButton.visible = restartRequired;
+		restartButton.active = restartButton.visible;
+		if (restartRequired) {
+			message = "Instalação pronta. Reinicie o Minecraft para carregar o multiplayer.";
+		} else if (ready && installer.exitCode() == Integer.MIN_VALUE) {
+			message = "SM64 Coop DX está instalado nesta instância.";
+		} else if (installer.exitCode() == Integer.MIN_VALUE) {
+			message = MarioCraftRom.hasCandidate(gameDirectory)
+				? "ROM encontrada. Clique em instalar para verificar a região USA e preparar o jogo."
+				: "ROM USA não encontrada. Copie sua ROM .z64, .n64 ou .v64 para a pasta acima.";
+		}
+	}
+
+	private void installOrLaunch() {
+		Path gameDirectory = minecraft.gameDirectory.toPath();
+		if (MarioCraftDependencyInstaller.isInstalled(gameDirectory)) {
+			try {
+				MarioCraftNativeGame.launch(minecraft);
+				TitleScreen title = parent instanceof TitleScreen existing ? existing : new TitleScreen();
+				minecraft.gui.setScreen(new MarioCraftMenuScreen(title));
+			} catch (IOException e) {
+				message = e.getMessage();
+			}
+			return;
+		}
+
+		try {
+			Path rom = MarioCraftRom.prepare(gameDirectory);
+			if (rom == null) {
+				message = "Coloque sua ROM USA (.z64, .n64 ou .v64) na pasta sm64craft e tente novamente.";
+				openInstallFolder();
+				return;
+			}
+			MarioCraftDependencyInstaller.current(gameDirectory).start();
+			message = "Baixando e preparando o SM64 Coop DX...";
+			refreshState();
+		} catch (IOException e) {
+			message = e.getMessage();
+		}
+	}
+
+	private void openInstallFolder() {
+		Path folder = MarioCraftRom.folder(minecraft.gameDirectory.toPath());
+		try {
+			Files.createDirectories(folder);
+			new ProcessBuilder("explorer.exe", folder.toString()).start();
+		} catch (IOException e) {
+			message = "Não consegui abrir a pasta. Copie sua ROM manualmente para: " + folder;
+		}
+	}
+
+	private String fit(String text, int maxWidth) {
+		if (font.width(text) <= maxWidth) return text;
+		String shortened = text;
+		while (shortened.length() > 4 && font.width(shortened + "...") > maxWidth) {
+			shortened = shortened.substring(1);
+		}
+		return "..." + shortened;
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MarioLobby.java b/fabric/src/client/java/dev/skycraft/client/MarioLobby.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioLobby.java
@@ -0,0 +1,227 @@
+package dev.skycraft.client;
+
+import static java.lang.foreign.ValueLayout.JAVA_BYTE;
+import static java.lang.foreign.ValueLayout.JAVA_INT;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import java.lang.foreign.MemorySegment;
+import java.lang.invoke.VarHandle;
+import java.nio.charset.StandardCharsets;
+import net.minecraft.client.Minecraft;
+import net.minecraft.network.chat.Component;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * MarioCraft multiplayer: everyone's Minecraft in one world while they play SM64 together.
+ *
+ * <p>SM64 (src/pc/mariocraft/mc_lobby.c) writes what this Minecraft should do into the lobby block
+ * at {@link Proto#OFF_LOBBY}: host (open this world to LAN, which e4mc puts on the internet), join
+ * the host's address, or be back in its own world. This answers with what it's doing (own world,
+ * hosting at a link, or in a friend's world) and how many players are in it. SM64 passes the host's
+ * link to everyone over its own network, so nobody types anything.
+ *
+ * <p>Only worlds the lobby joined are left again: a /join typed by the player stays theirs.
+ */
+public final class MarioLobby {
+	private static final VarHandle INT = JAVA_INT.varHandle();
+	private static final long RETRY_MS = 20_000; // between attempts to reach the same address
+	private static final long MAX_RETRY_MS = 120_000;
+
+	private static int lastWantSeq = -1;
+	private static int want = Proto.LB_WANT_NOTHING;
+	private static String wantAddr = "";
+	private static @Nullable String lobbyJoined; // the address the lobby joined (and may leave again)
+	private static String triedAddr = "";
+	private static int tries;
+	private static long nextTry;
+	private static int stateSeq;
+	private static int linkGeneration = -1;
+
+	private MarioLobby() {
+	}
+
+	private static @Nullable MemorySegment segment() {
+		MemorySegment s = SkyLink.segment();
+		if (s == null || (s.get(JAVA_INT, Proto.H_FEATURES) & Proto.FEATURE_LOBBY) == 0) {
+			return null;
+		}
+		return s;
+	}
+
+	/** Every client tick (render thread). */
+	public static void tick(Minecraft minecraft) {
+		MemorySegment s = segment();
+		if (s == null) {
+			return;
+		}
+		if (linkGeneration != SkyLink.generation()) {
+			linkGeneration = SkyLink.generation();
+			lastWantSeq = -1;
+			want = Proto.LB_WANT_NOTHING;
+			wantAddr = "";
+			triedAddr = "";
+			tries = 0;
+			nextTry = 0;
+			sentFace = null;
+			nextFaceCheck = 0;
+		}
+		readWant(s);
+		act(minecraft);
+		writeState(s, minecraft);
+		writeFace(s, minecraft);
+	}
+
+	private static int @org.jspecify.annotations.Nullable [] sentFace;
+	private static int faceSeq;
+	private static long nextFaceCheck;
+
+	/** The player's skin face for SM64's HUD head (mc_steve.c), whenever it changes. */
+	private static void writeFace(MemorySegment s, Minecraft minecraft) {
+		long now = System.currentTimeMillis();
+		if (now < nextFaceCheck) {
+			return;
+		}
+		nextFaceCheck = now + 2000;
+		int[] face = dev.skycraft.client.render.SkinFace.face(minecraft);
+		if (face == null || java.util.Arrays.equals(face, sentFace)) {
+			return;
+		}
+		sentFace = face;
+		long b = Proto.OFF_LOBBY;
+		faceSeq += 2;
+		INT.setRelease(s, b + Proto.LB_FACE_SEQ, faceSeq - 1);
+		for (int i = 0; i < face.length; i++) {
+			s.set(JAVA_INT, b + Proto.LB_FACE + i * 4L, face[i]);
+		}
+		INT.setRelease(s, b + Proto.LB_FACE_SEQ, faceSeq);
+	}
+
+	private static void readWant(MemorySegment s) {
+		long b = Proto.OFF_LOBBY;
+		for (int attempt = 0; attempt < 4; attempt++) {
+			int seq1 = (int) INT.getAcquire(s, b + Proto.LB_WANT_SEQ);
+			if (seq1 == lastWantSeq) {
+				return;
+			}
+			if ((seq1 & 1) != 0) {
+				continue;
+			}
+			int w = s.get(JAVA_INT, b + Proto.LB_WANT);
+			String addr = readText(s, b + Proto.LB_WANT_ADDR);
+			int seq2 = (int) INT.getAcquire(s, b + Proto.LB_WANT_SEQ);
+			if (seq1 == seq2) {
+				lastWantSeq = seq1;
+				if (w != want || !addr.equals(wantAddr)) {
+					SkyCraft.LOG.info("MarioCraft: lobby wants {} {}", w, addr);
+					tries = 0;
+					nextTry = 0;
+				}
+				want = w;
+				wantAddr = addr;
+				return;
+			}
+		}
+	}
+
+	private static void act(Minecraft minecraft) {
+		if (minecraft.level == null || minecraft.player == null || minecraft.gui.screen() != null && !(minecraft.gui.screen() instanceof net.minecraft.client.gui.screens.ChatScreen)) {
+			return; // between worlds (MirrorWorld is busy), or a screen is open
+		}
+		var server = minecraft.getSingleplayerServer();
+		String friend = MirrorWorld.friendAddress(minecraft);
+		switch (want) {
+			case Proto.LB_WANT_HOST -> {
+				if (server != null && !server.isPublished()) {
+					int port = net.minecraft.util.HttpUtil.getAvailablePort();
+					boolean ok = server.publishServer(net.minecraft.server.MinecraftServer.MultiplayerScope.LAN, false, port);
+					SkyCraft.LOG.info("MarioCraft: opened this world to the SM64 session's players (port {}, {})", port, ok ? "ok" : "FAILED");
+				} else if (server == null && friend != null && friend.equals(lobbyJoined)) {
+					leave(minecraft); // we host now: back to our own world first
+				}
+			}
+			case Proto.LB_WANT_JOIN -> {
+				if (wantAddr.isEmpty() || server == null && wantAddr.equals(friend)) {
+					tries = 0;
+					return;
+				}
+				long now = System.currentTimeMillis();
+				if (!wantAddr.equals(triedAddr)) {
+					triedAddr = wantAddr;
+					tries = 0;
+					nextTry = 0;
+				}
+				if (now < nextTry) {
+					return;
+				}
+				tries = Math.min(tries + 1, 4);
+				nextTry = now + Math.min(MAX_RETRY_MS, RETRY_MS << (tries - 1));
+				SkyCraft.LOG.info("MarioCraft: joining {} (retry delay {}s)", wantAddr, (nextTry - now) / 1000);
+				minecraft.gui.hud.getChat().addClientSystemMessage(Component.literal("Joining the host's world..."));
+				lobbyJoined = wantAddr;
+				MirrorWorld.joinFriend(minecraft, wantAddr);
+			}
+			case Proto.LB_WANT_OWN_WORLD -> {
+				if (friend != null && friend.equals(lobbyJoined)) {
+					leave(minecraft);
+				}
+			}
+			default -> {
+			}
+		}
+	}
+
+	private static void leave(Minecraft minecraft) {
+		SkyCraft.LOG.info("MarioCraft: leaving the session's world {}", lobbyJoined);
+		lobbyJoined = null;
+		MirrorWorld.leaveFriend(minecraft);
+	}
+
+	private static void writeState(MemorySegment s, Minecraft minecraft) {
+		int world = Proto.LB_WORLD_NONE;
+		String link = "";
+		int players = 0;
+		if (minecraft.level != null && minecraft.player != null && minecraft.getConnection() != null) {
+			players = minecraft.getConnection().getOnlinePlayers().size();
+			var server = minecraft.getSingleplayerServer();
+			String friend = MirrorWorld.friendAddress(minecraft);
+			if (server != null) {
+				world = server.isPublished() ? Proto.LB_WORLD_HOSTING : Proto.LB_WORLD_OWN;
+				String hostLink = server.isPublished() ? DiscordPresence.currentHostLink() : null;
+				link = hostLink != null ? hostLink : "";
+			} else if (friend != null) {
+				world = Proto.LB_WORLD_FRIEND;
+				link = friend;
+			}
+		}
+		long b = Proto.OFF_LOBBY;
+		stateSeq += 2;
+		INT.setRelease(s, b + Proto.LB_STATE_SEQ, stateSeq - 1);
+		s.set(JAVA_INT, b + Proto.LB_STATE, world);
+		s.set(JAVA_INT, b + Proto.LB_PLAYERS, players);
+		writeText(s, b + Proto.LB_LINK, link);
+		INT.setRelease(s, b + Proto.LB_STATE_SEQ, stateSeq);
+	}
+
+	private static String readText(MemorySegment s, long at) {
+		byte[] bytes = new byte[Proto.LB_TEXT_BYTES];
+		int n = 0;
+		while (n < bytes.length - 1) {
+			byte c = s.get(JAVA_BYTE, at + n);
+			if (c == 0) {
+				break;
+			}
+			bytes[n++] = c;
+		}
+		return new String(bytes, 0, n, StandardCharsets.UTF_8).trim();
+	}
+
+	private static void writeText(MemorySegment s, long at, String text) {
+		byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+		int n = Math.min(bytes.length, Proto.LB_TEXT_BYTES - 1);
+		for (int i = 0; i < Proto.LB_TEXT_BYTES; i++) {
+			s.set(JAVA_BYTE, at + i, i < n ? bytes[i] : 0);
+		}
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MarioSounds.java b/fabric/src/client/java/dev/skycraft/client/MarioSounds.java
new file mode 100644
index 0000000..dfd1368
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MarioSounds.java
@@ -0,0 +1,199 @@
+package dev.skycraft.client;
+
+import static java.lang.foreign.ValueLayout.JAVA_BYTE;
+import static java.lang.foreign.ValueLayout.JAVA_INT;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyCollision;
+import dev.skycraft.world.SkyDig;
+import dev.skycraft.world.SkyTri;
+import java.lang.foreign.MemorySegment;
+import java.lang.invoke.VarHandle;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.resources.sounds.SimpleSoundInstance;
+import net.minecraft.client.resources.sounds.SoundInstance;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.Identifier;
+import net.minecraft.sounds.SoundEvent;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.phys.AABB;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * MarioCraft: Minecraft's sounds for SM64.
+ *
+ * <ul>
+ * <li>Music: C418's, picked by SM64 for each level and event (mc_music.c) and played here, looping,
+ * instead of SM64's own (which it mutes). Played on the jukebox volume (Music & Sounds options,
+ * "Jukebox/Note Blocks"), since SkyCraft keeps Minecraft's own music off.</li>
+ * <li>Footsteps on SM64's ground: Minecraft only steps on blocks; on SM64's level it was silent.
+ * The step sound is the block the ground is made of (grass, stone, snow, sand, planks...).</li>
+ * <li>Sounds for what SM64 does to Steve (IN_SOUND): a ground pound, lava, picking up and throwing,
+ * being squished.</li>
+ * </ul>
+ */
+public final class MarioSounds {
+	private static final VarHandle INT = JAVA_INT.varHandle();
+	private static int lastMusicSeq = -1;
+	private static String musicName = "";
+	private static @Nullable SoundInstance music;
+	private static double lastWalk, lastX, lastZ;
+	private static final List<SkyTri> TRIS = new ArrayList<>();
+
+	private MarioSounds() {
+	}
+
+	/** Every client tick. */
+	public static void tick(Minecraft minecraft) {
+		music(minecraft);
+		footsteps(minecraft);
+	}
+
+	// ---- music -------------------------------------------------------------------------------
+
+	private static void music(Minecraft minecraft) {
+		MemorySegment s = SkyLink.segment();
+		if (s == null || !SkyLink.active() || (s.get(JAVA_INT, Proto.H_FEATURES) & Proto.FEATURE_LOBBY) == 0) {
+			stopMusic(minecraft);
+			lastMusicSeq = -1;
+			return;
+		}
+		long b = Proto.OFF_LOBBY;
+		int seq1 = (int) INT.getAcquire(s, b + Proto.LB_MUSIC_SEQ);
+		if (seq1 != lastMusicSeq && (seq1 & 1) == 0) {
+			byte[] bytes = new byte[Proto.LB_MUSIC_BYTES];
+			int n = 0;
+			while (n < bytes.length - 1) {
+				byte c = s.get(JAVA_BYTE, b + Proto.LB_MUSIC + n);
+				if (c == 0) {
+					break;
+				}
+				bytes[n++] = c;
+			}
+			int seq2 = (int) INT.getAcquire(s, b + Proto.LB_MUSIC_SEQ);
+			if (seq1 == seq2) {
+				lastMusicSeq = seq1;
+				String name = new String(bytes, 0, n, StandardCharsets.US_ASCII);
+				if (!name.equals(musicName)) {
+					musicName = name;
+					stopMusic(minecraft);
+					nextMusicTry = 0;
+					musicTries = 0;
+				}
+			}
+		}
+		// (Re)start it: it loops, but a sound engine reload or a dimension change stops sounds. Not
+		// more often than every few seconds, and not forever: a track that won't start mustn't be
+		// retried every tick (each try loads, fails and logs: it made the game stutter).
+		long now = System.currentTimeMillis();
+		if (!musicName.isEmpty() && (music == null || !minecraft.getSoundManager().isActive(music)) && now >= nextMusicTry
+			&& musicTries < 5) {
+			Identifier id = Identifier.fromNamespaceAndPath(dev.skycraft.SkyCraft.MOD_ID, "music." + musicName.replace('/', '.'));
+			music = new SimpleSoundInstance(id, SoundSource.RECORDS, 1.0F, 1.0F, RandomSource.create(), true, 0,
+				SoundInstance.Attenuation.NONE, 0.0, 0.0, 0.0, true);
+			minecraft.getSoundManager().play(music);
+			nextMusicTry = now + 4000;
+			musicTries++;
+		}
+		if (music != null && minecraft.getSoundManager().isActive(music)) {
+			musicTries = 0;  // it's playing: a later stop (a reload) gets its tries again
+		}
+	}
+
+	private static long nextMusicTry;
+	private static int musicTries;
+
+	private static void stopMusic(Minecraft minecraft) {
+		if (music != null) {
+			minecraft.getSoundManager().stop(music);
+			music = null;
+		}
+	}
+
+	// ---- footsteps -----------------------------------------------------------------------------
+
+	private static void footsteps(Minecraft minecraft) {
+		var player = minecraft.player;
+		if (player == null) {
+			return;
+		}
+		double dx = player.getX() - lastX, dz = player.getZ() - lastZ;
+		lastX = player.getX();
+		lastZ = player.getZ();
+		if (!SkyLink.active() || !player.onGround() || player.isSpectator()) {
+			return;
+		}
+		// Minecraft's own pace: a step every 1/0.6 blocks walked.
+		double d = Math.sqrt(dx * dx + dz * dz);
+		if (d > 2.0) {
+			return; // a teleport, not a step
+		}
+		lastWalk += d;
+		if (lastWalk < 1.0 / 0.6) {
+			return;
+		}
+		lastWalk = 0.0;
+		if (player.isSilent() || player.isShiftKeyDown()) {
+			return;
+		}
+		// Standing on a Minecraft block: it played its own.
+		if (!minecraft.level.getBlockState(player.getOnPos()).isAir()) {
+			return;
+		}
+		int material = materialUnderFeet(player.getX(), player.getY(), player.getZ());
+		if (material <= 0) {
+			return;
+		}
+		var type = SkyDig.materialState(material).getSoundType();
+		minecraft.getSoundManager().play(new SimpleSoundInstance(type.getStepSound(), SoundSource.PLAYERS, type.getVolume() * 0.15F, type.getPitch(),
+			RandomSource.create(), player.getX(), player.getY(), player.getZ()));
+	}
+
+	/** The material of SM64's floor right under the player's feet (Proto.DIG_*), or 0. */
+	private static int materialUnderFeet(double x, double y, double z) {
+		TRIS.clear();
+		SkyCollision.trianglesNear(new AABB(x - 0.3, y - 0.6, z - 0.3, x + 0.3, y + 0.2, z + 0.3), TRIS);
+		int best = 0;
+		double bestY = Double.NEGATIVE_INFINITY;
+		for (SkyTri t : TRIS) {
+			if (t.ny < 0.4) {
+				continue;
+			}
+			double h = t.heightAt(x, z);
+			if (!Double.isNaN(h) && h <= y + 0.1 && h > bestY) {
+				bestY = h;
+				best = t.material == Proto.DIG_NONE ? Proto.DIG_STONE : t.material;
+			}
+		}
+		return best;
+	}
+
+	// ---- one-off sounds (IN_SOUND) ------------------------------------------------------------
+
+	public static void play(Minecraft minecraft, int code) {
+		if (minecraft.player == null) {
+			return;
+		}
+		String name = switch (code) {
+			case Proto.SOUND_POUND -> "entity.generic.big_fall";
+			case Proto.SOUND_BURN -> "entity.generic.burn";
+			case Proto.SOUND_PICKUP -> "entity.item.pickup";
+			case Proto.SOUND_THROW -> "entity.snowball.throw";
+			case Proto.SOUND_CRUSH -> "block.anvil.land";
+			default -> null;
+		};
+		if (name == null) {
+			return;
+		}
+		SoundEvent event = BuiltInRegistries.SOUND_EVENT.getValue(Identifier.withDefaultNamespace(name));
+		if (event != null) {
+			var p = minecraft.player;
+			minecraft.getSoundManager().play(new SimpleSoundInstance(event, SoundSource.PLAYERS, 1.0F, 1.0F, RandomSource.create(), p.getX(), p.getY(), p.getZ()));
+		}
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MinecraftSm64View.java b/fabric/src/client/java/dev/skycraft/client/MinecraftSm64View.java
new file mode 100644
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MinecraftSm64View.java
@@ -0,0 +1,129 @@
+package dev.skycraft.client;
+
+import com.mojang.blaze3d.pipeline.RenderTarget;
+import com.mojang.blaze3d.pipeline.TextureTarget;
+import com.mojang.blaze3d.platform.NativeImage;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.renderpearl.api.GpuFormat;
+import dev.skycraft.link.FrameLink;
+import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry;
+import net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.GuiGraphicsExtractor;
+import net.minecraft.client.renderer.RenderPipelines;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.minecraft.resources.Identifier;
+
+/** Displays SM64's locally rendered frame inside the visible Minecraft client. */
+public final class MinecraftSm64View {
+	private static final Identifier FRAME_ID = Identifier.fromNamespaceAndPath("skycraft", "mariocraft_sm64_frame");
+	private static TextureTarget backgroundTarget;
+	private static NativeImage backgroundImage;
+	private static DynamicTexture frontEndTexture;
+	private static int textureWidth, textureHeight;
+	private static long uploadedCounter = -1, frontEndUploadedCounter = -1;
+
+	private MinecraftSm64View() { }
+
+	public static void register() {
+		HudElementRegistry.attachElementBefore(VanillaHudElements.CROSSHAIR, FRAME_ID, MinecraftSm64View::render);
+	}
+
+	private static void render(GuiGraphicsExtractor gui, net.minecraft.client.DeltaTracker deltaTracker) {
+		if (!SkyClient.minecraftViewMode()) return;
+		FrameLink.poll();
+		FrameLink.Frame frame = FrameLink.latest();
+		int screenWidth = gui.guiWidth();
+		int screenHeight = gui.guiHeight();
+		if (frame == null) {
+			gui.fill(0, 0, screenWidth, screenHeight, 0xFF000000);
+			gui.centeredText(Minecraft.getInstance().font, "Aguardando o SM64...", screenWidth / 2, screenHeight / 2 - 4, 0xFFFFFFFF);
+			gui.centeredText(Minecraft.getInstance().font, "Inicie o MarioCraft pela opção Minecraft View.", screenWidth / 2, screenHeight / 2 + 10, 0xFFB8B8B8);
+		}
+	}
+
+	/** Draw the SM64 title/save/lobby menu over Minecraft's title screen. */
+	public static void renderFrontEnd(GuiGraphicsExtractor gui, int screenWidth, int screenHeight) {
+		FrameLink.poll();
+		FrameLink.requestViewSize(Minecraft.getInstance().getWindow().getWidth(), Minecraft.getInstance().getWindow().getHeight());
+		FrameLink.Frame frame = FrameLink.latest();
+		if (frame == null) {
+			gui.fill(0, 0, screenWidth, screenHeight, 0xFF000000);
+			gui.centeredText(Minecraft.getInstance().font, "Aguardando o menu do SM64...", screenWidth / 2, screenHeight / 2 - 4, 0xFFFFFFFF);
+			gui.centeredText(Minecraft.getInstance().font, "O SM64 Coop DX continua rodando em segundo plano.", screenWidth / 2, screenHeight / 2 + 10, 0xFFB8B8B8);
+			return;
+		}
+		Minecraft minecraft = Minecraft.getInstance();
+		if (!uploadFrame(minecraft, frame)) return;
+		ensureFrontEndTexture(minecraft);
+		if (frontEndUploadedCounter != frame.counter()) {
+			var menuPixels = frontEndTexture.getPixels().getPixelBytes();
+			var rgba = frame.rgba();
+			int rowBytes = textureWidth * 4;
+			menuPixels.clear();
+			for (int y = 0; y < textureHeight; y++) {
+				menuPixels.put(rgba, y * rowBytes, rowBytes);
+			}
+			frontEndTexture.upload();
+			frontEndUploadedCounter = frame.counter();
+		}
+		// Register it with Minecraft's normal GUI texture manager: drawing RenderTarget's raw
+		// color view through an extracted GUI state produces only the first sampled pixel here.
+		gui.blit(RenderPipelines.GUI_TEXTURED, FRAME_ID, 0, 0, 0.0F, 0.0F,
+			screenWidth, screenHeight, textureWidth, textureHeight, textureWidth, textureHeight, -1);
+	}
+
+	/** Draw the SM64 frame into the world target before Minecraft renders its first-person hand. */
+	public static void renderBackground(Minecraft minecraft) {
+		if (!SkyClient.minecraftViewMode()) return;
+		FrameLink.poll();
+		FrameLink.requestViewSize(minecraft.getWindow().getWidth(), minecraft.getWindow().getHeight());
+		FrameLink.Frame frame = FrameLink.latest();
+		if (frame == null || !uploadFrame(minecraft, frame)) return;
+
+		RenderTarget output = minecraft.gameRenderer.mainRenderTarget();
+		backgroundTarget.blitAndBlendToTexture(output.getColorTextureView(), output.getDepthTextureView());
+	}
+
+	private static boolean uploadFrame(Minecraft minecraft, FrameLink.Frame frame) {
+
+		if (backgroundTarget == null || frame.width() != textureWidth || frame.height() != textureHeight) {
+			if (backgroundTarget != null) backgroundTarget.destroyBuffers();
+			if (backgroundImage != null) backgroundImage.close();
+			if (frontEndTexture != null) {
+				minecraft.getTextureManager().release(FRAME_ID);
+				frontEndTexture = null;
+			}
+			textureWidth = frame.width();
+			textureHeight = frame.height();
+			backgroundTarget = new TextureTarget("MarioCraft SM64 background", textureWidth, textureHeight,
+				GpuFormat.RGBA8_UNORM, null);
+			backgroundImage = new NativeImage(textureWidth, textureHeight, false);
+			uploadedCounter = -1;
+			frontEndUploadedCounter = -1;
+		}
+		if (uploadedCounter != frame.counter()) {
+			byte[] rgba = frame.rgba();
+			var pixels = backgroundImage.getPixelBytes();
+			if (pixels == null || rgba.length != (long) textureWidth * textureHeight * 4) return false;
+			pixels.clear();
+			// RenderTarget blitting uses the opposite vertical origin from the shared frame.
+			int rowBytes = textureWidth * 4;
+			for (int y = textureHeight - 1; y >= 0; y--) {
+				pixels.put(rgba, y * rowBytes, rowBytes);
+			}
+			var encoder = RenderSystem.getDevice().createCommandEncoder();
+			encoder.writeToTexture(backgroundTarget.getColorTexture(), backgroundImage);
+			encoder.submit();
+			uploadedCounter = frame.counter();
+		}
+		return true;
+	}
+
+	private static void ensureFrontEndTexture(Minecraft minecraft) {
+		if (frontEndTexture != null) return;
+		frontEndTexture = new DynamicTexture("MarioCraft SM64 front end", textureWidth, textureHeight, false);
+		minecraft.getTextureManager().register(FRAME_ID, frontEndTexture);
+		frontEndUploadedCounter = -1;
+	}
+}
diff --git a/fabric/src/client/java/dev/skycraft/client/MovingSurfaces.java b/fabric/src/client/java/dev/skycraft/client/MovingSurfaces.java
new file mode 100644
index 0000000..de70332
--- /dev/null
+++ b/fabric/src/client/java/dev/skycraft/client/MovingSurfaces.java
@@ -0,0 +1,238 @@
+package dev.skycraft.client;
+
+import static java.lang.foreign.ValueLayout.JAVA_DOUBLE;
+import static java.lang.foreign.ValueLayout.JAVA_INT;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyTri;
+import java.lang.foreign.MemorySegment;
+import java.lang.invoke.VarHandle;
+import java.util.List;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.world.phys.AABB;
+
+/**
+ * MarioCraft: SM64's moving and solid objects (platforms, elevators, seesaws, bridges, crates,
+ * "!" boxes, gates, Whomps...). SM64 rebuilds their collision every game frame and writes the
+ * triangles near the player, each with the object it belongs to and that object's transform,
+ * into a table at {@link Proto#OFF_MOVING}. The local player collides with them like with the
+ * level ({@link SkyCollider}), and while standing on one is carried along with it: whatever the
+ * object did since the last tick (moved, turned, tilted) is applied to the player's feet.
+ */
+public final class MovingSurfaces {
+	private static final VarHandle INT = JAVA_INT.varHandle();
+	private static final double UNITS = 100.0; // SM64 units per block
+	private static final double MAX_CARRY = 2.0; // blocks per tick; more means the object was replaced
+
+	private static int lastSeq = -1;
+	private static SkyTri[] tris = new SkyTri[0];
+	private static int[] triObject = new int[0]; // index into the objects below, or -1
+	private static long[] objectKeys = new long[0]; // id << 32 | gen
+	private static double[][] objectMatrices = new double[0][];
+	private static double originX;
+	private static int shiftY;
+
+	private static long ridingKey;
+	private static double[] ridingRef;
+
+	private MovingSurfaces() {
+	}
+
+	private static MemorySegment segment() {
+		MemorySegment s = SkyLink.segment();
+		if (s == null || (s.get(JAVA_INT, Proto.H_FEATURES) & Proto.FEATURE_MOVING) == 0) {
+			return null;
+		}
+		return s;
+	}
+
+	/** Picks up SM64's latest table (cheap when nothing changed). */
+	public static void refresh() {
+		MemorySegment s = segment();
+		if (s == null) {
+			if (tris.length > 0) {
+				tris = new SkyTri[0];
+				triObject = new int[0];
+				objectKeys = new long[0];
+				objectMatrices = new double[0][];
+			}
+			lastSeq = -1;
+			return;
+		}
+		long b = Proto.OFF_MOVING;
+		for (int attempt = 0; attempt < 50; attempt++) {
+			int seq1 = (int) INT.getAcquire(s, b + Proto.MV_SEQ);
+			if (seq1 == lastSeq) {
+				return;
+			}
+			if ((seq1 & 1) != 0 || seq1 == 0) {
+				Thread.onSpinWait();
+				if (seq1 == 0) {
+					return; // SM64 hasn't written one yet
+				}
+				continue;
+			}
+			int numObjects = Math.min(s.get(JAVA_INT, b + Proto.MV_NUM_OBJECTS), Proto.MV_MAX_OBJECTS);
+			int numTris = Math.min(s.get(JAVA_INT, b + Proto.MV_NUM_TRIS), Proto.MV_MAX_TRIS);
+			double ox = s.get(JAVA_DOUBLE, b + Proto.MV_ORIGIN_X);
+			int sy = s.get(JAVA_INT, b + Proto.MV_SHIFT_Y);
+			int[] objRaw = new int[Math.max(0, numObjects) * 20];
+			MemorySegment.copy(s, JAVA_INT, b + Proto.MV_OBJECTS, objRaw, 0, objRaw.length);
+			int[] triRaw = new int[Math.max(0, numTris) * 10];
+			MemorySegment.copy(s, JAVA_INT, b + Proto.MV_TRIS, triRaw, 0, triRaw.length);
+			VarHandle.loadLoadFence();
+			if ((int) INT.getAcquire(s, b + Proto.MV_SEQ) != seq1) {
+				continue; // SM64 wrote meanwhile: read again
+			}
+			lastSeq = seq1;
+			originX = ox;
+			shiftY = sy;
+			long[] keys = new long[numObjects];
+			double[][] matrices = new double[numObjects][];
+			for (int i = 0; i < numObjects; i++) {
+				int o = i * 20;
+				keys[i] = ((long) objRaw[o] << 32) | (objRaw[o + 1] & 0xFFFFFFFFL);
+				double[] m = new double[16];
+				for (int k = 0; k < 16; k++) {
+					m[k] = Float.intBitsToFloat(objRaw[o + 2 + k]);
+				}
+				matrices[i] = m;
+			}
+			SkyTri[] newTris = new SkyTri[numTris];
+			int[] owner = new int[numTris];
+			float[] v = new float[9];
+			int kept = 0;
+			for (int i = 0; i < numTris; i++) {
+				int t = i * 10;
+				for (int k = 0; k < 9; k += 3) {
+					v[k] = (float) (ox + Float.intBitsToFloat(triRaw[t + k]) / UNITS);
+					v[k + 1] = (float) ((Float.intBitsToFloat(triRaw[t + k + 1]) - sy) / UNITS);
+					v[k + 2] = (float) (Float.intBitsToFloat(triRaw[t + k + 2]) / UNITS);
+				}
+				int objFlags = triRaw[t + 9];
+				int obj = objFlags & 0xFFFF;
+				int flags = (objFlags >>> 16) & 0xFFFF;
+				SkyTri tri = new SkyTri(v, 0, flags);
+				if (tri.degenerate()) {
+					continue;
+				}
+				newTris[kept] = tri;
+				owner[kept] = obj < numObjects ? obj : -1;
+				kept++;
+			}
+			tris = java.util.Arrays.copyOf(newTris, kept);
+			triObject = java.util.Arrays.copyOf(owner, kept);
+			objectKeys = keys;
+			objectMatrices = matrices;
+			return;
+		}
+	}
+
+	/** Adds every moving triangle whose bounds overlap {@code box}. */
+	public static void trianglesNear(AABB box, List<SkyTri> out) {
+		for (SkyTri t : tris) {
+			if (t.maxX >= box.minX && t.minX <= box.maxX && t.maxY >= box.minY && t.minY <= box.maxY && t.maxZ >= box.minZ && t.minZ <= box.maxZ) {
+				out.add(t);
+			}
+		}
+	}
+
+	/** After the player moved: are their feet on one of the objects? Then that's what carries them. */
+	public static void afterMove(double x, double y, double z) {
+		long under = 0;
+		double best = Double.NEGATIVE_INFINITY;
+		SkyTri[] ts = tris;
+		int[] owners = triObject;
+		for (int i = 0; i < ts.length; i++) {
+			SkyTri t = ts[i];
+			int o = owners[i];
+			if (o < 0 || !t.walkable || t.maxY < y - 0.1 || t.minY > y + 0.1) {
+				continue;
+			}
+			for (int s = 0; s < 5; s++) {
+				double sx = x + (s == 1 ? 0.25 : s == 2 ? -0.25 : 0), sz = z + (s == 3 ? 0.25 : s == 4 ? -0.25 : 0);
+				double h = t.heightAt(sx, sz);
+				if (!Double.isNaN(h) && Math.abs(h - y) < 0.06 && h > best) {
+					best = h;
+					under = objectKeys[o];
+				}
+			}
+		}
+		if (under != ridingKey) {
+			ridingKey = under;
+			double[] m = under != 0 ? matrixOf(under) : null;
+			ridingRef = m != null ? m.clone() : null;
+			if (m == null) {
+				ridingKey = 0;
+			}
+		}
+	}
+
+	private static double[] matrixOf(long key) {
+		long[] keys = objectKeys;
+		for (int i = 0; i < keys.length; i++) {
+			if (keys[i] == key) {
+				return objectMatrices[i];
+			}
+		}
+		return null;
+	}
+
+	/** End of a client tick: what the object the player stands on did, happens to the player too. */
+	public static void carry(LocalPlayer player) {
+		refresh();
+		if (ridingKey == 0 || ridingRef == null) {
+			return;
+		}
+		double[] now = matrixOf(ridingKey);
+		if (now == null) {
+			ridingKey = 0; // gone
+			ridingRef = null;
+			return;
+		}
+		// The feet in SM64 units, back into the object's own space as it was, out as it is now.
+		double fx = (player.getX() - originX) * UNITS, fy = player.getY() * UNITS + shiftY, fz = player.getZ() * UNITS;
+		double[] local = inverseApply(ridingRef, fx, fy, fz);
+		if (local == null) {
+			ridingRef = now.clone();
+			return;
+		}
+		double nx = local[0] * now[0] + local[1] * now[4] + local[2] * now[8] + now[12];
+		double ny = local[0] * now[1] + local[1] * now[5] + local[2] * now[9] + now[13];
+		double nz = local[0] * now[2] + local[1] * now[6] + local[2] * now[10] + now[14];
+		ridingRef = now.clone();
+		double dx = (nx - fx) / UNITS, dy = (ny - fy) / UNITS, dz = (nz - fz) / UNITS;
+		if (dx * dx + dy * dy + dz * dz > MAX_CARRY * MAX_CARRY || (dx == 0 && dy == 0 && dz == 0)) {
+			return;
+		}
+		// Only the current position moves (not last tick's), so it's drawn as smooth motion.
+		player.setPos(player.getX() + dx, player.getY() + dy, player.getZ() + dz);
+	}
+
+	/** p = (q - t) * inverse(A), for a row-vector affine matrix m = [A; t]. */
+	private static double[] inverseApply(double[] m, double qx, double qy, double qz) {
+		double a = m[0], b = m[1], c = m[2];
+		double d = m[4], e = m[5], f = m[6];
+		double g = m[8], h = m[9], i = m[10];
+		double det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
+		if (Math.abs(det) < 1e-9) {
+			return null;
+		}
+		double inv = 1.0 / det;
+		// inverse(A), row-major
+		double i00 = (e * i - f * h) * inv, i01 = (c * h - b * i) * inv, i02 = (b * f - c * e) * inv;
+		double i10 = (f * g - d * i) * inv, i11 = (a * i - c * g) * inv, i12 = (c * d - a * f) * inv;
+		double i20 = (d * h - e * g) * inv, i21 = (b * g - a * h) * inv, i22 = (a * e - b * d) * inv;
+		double px = qx - m[12], py = qy - m[13], pz = qz - m[14];
+		return new double[] {
+			px * i00 + py * i10 + pz * i20,
+			px * i01 + py * i11 + pz * i21,
+			px * i02 + py * i12 + pz * i22,
+		};
+	}
+
+	public static boolean riding() {
+		return ridingKey != 0;
+	}
+}
